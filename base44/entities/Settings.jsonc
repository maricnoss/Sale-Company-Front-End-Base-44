{
  "name": "Settings",
  "type": "object",
  "properties": {
    "workspace_name": {
      "type": "string"
    },
    "tax_active": {
      "type": "boolean",
      "default": false
    },
    "default_vat_rate": {
      "type": "number",
      "default": 23
    }
  },
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}